# ─────────────────────────────────────────────────────────────────────────────
# AINU eKYC (liveness) — ต่อท้ายไฟล์ .env ที่มีอยู่แล้ว
#
# ไฟล์นี้เป็น template เฉพาะส่วน liveness เท่านั้น ไม่ใช่ template ของทั้งโปรเจกต์
# ตัวแปรอื่น (VITE_API_URL ฯลฯ) ที่อยู่ใน .env เดิม ไม่ต้องแตะ
#
# ⚠️ Vite อ่าน env ตอน start เท่านั้น — เติมแล้วต้อง restart dev server
#    ไม่งั้นค่าจะเป็น undefined แล้ว SDK จะ error โดยไม่บอกสาเหตุ
#
# ⚠️ Vite inline ค่าพวกนี้ลง bundle ตอน build → accountSecret อ่านได้จาก JS ที่ ship
#    build ที่มีค่าจริง อย่าเอาขึ้นที่ที่คนนอกเข้าถึงได้
# ─────────────────────────────────────────────────────────────────────────────

# ⚠️ ไม่ใช่ demo-dga-pmcare (นั่นคือ username ของเว็บเดโม คนละตัวกัน หน้าตาคล้ายมาก)
VITE_ACCOUNT_ID=ekycsdk-dga-pmcare

# ค่าลับ — เอาจาก detail/DGA-PCA001_credential_พม.xlsx ช่อง Web SDK
# หรือก๊อปจาก ekyc-vue-demo/.env.local บรรทัด VITE_ACCOUNT_SECRET
VITE_ACCOUNT_SECRET=

# flow นี้เป็น liveness อย่างเดียว ไม่มี OCR ไม่มี DOPA · ลองได้ 3 รอบต่อ 1 transaction
VITE_FLOW_ID=DGA-PMCARE-001

# TH | EN
VITE_LANGUAGE=TH
